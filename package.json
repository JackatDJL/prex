{
  "name": "@jkxrx/prex",
  "version": "0.1.0",
  "description": "Previews Extended: reserve local ports and run development servers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "prex": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/integrations.js",
    "dist/ports.js",
    "dist/project-config.js",
    "dist/sessions.js",
    "dist/endpoints.js",
    "README.md",
    "assets/",
    "CHANGELOG.md",
    "skills/prex/SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/cli.test.js",
    "prepack": "npm run build",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only",
    "release": "changeset publish",
    "package:linux": "bash packaging/build-linux.sh"
  },
  "dependencies": {
    "effect": "^4.1.5",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackatDJL/prex.git"
  }
}
